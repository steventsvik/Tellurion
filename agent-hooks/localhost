#!/bin/bash
# Tellurion localhost sessions: dev servers that run in their own terminal tab, so they
# keep running after the agent (or terminal) that started them is gone.
#
#   localhost start [--log FILE] -- 'npm run dev'   open a session for a server in this folder
#   localhost logs <id> [lines]                     recent output, without terminal colors
#   localhost restart <id> | stop <id>              control a session
#   localhost list                                  sessions and their URLs
#   localhost rewrite '<shell command>' [--cwd DIR] [--background]
#                                                   (for agent hooks) the `start` command
#                                                   for a server command, or exit 1
#
# The app opens and tracks the sessions; this script only asks it to, through an OSC 777
# notification written to the terminal it runs in.

# TELLURION_TEST_HOME moves .ghostty-extreme for a test copy of the app, as in `tellurion`.
dir="${TELLURION_TEST_HOME:-$HOME}/.ghostty-extreme/localhost"
self="~/.ghostty-extreme/bin/localhost"

quote() { printf "'%s'" "${1//\'/\'\\\'\'}"; }
trim() { local s="$1"; s="${s#"${s%%[![:space:]]*}"}"; printf '%s' "${s%"${s##*[![:space:]]}"}"; }

# The terminal to talk to: ours, or (for agents that run commands without one) the
# first ancestor's.
term() {
  if { : > /dev/tty; } 2>/dev/null; then echo /dev/tty; return; fi
  local pid=$PPID t
  while [ "${pid:-1}" -gt 1 ]; do
    t=$(ps -o tty= -p "$pid" 2>/dev/null | tr -d ' ')
    case "$t" in ""|"??") ;; *) echo "/dev/$t"; return ;; esac
    pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
  done
  return 1
}

send() {
  local tty
  tty=$(term) || return 1
  # Add this launch's secret, so the app can tell real events from printed text.
  printf '\e]777;notify;ghostty-extreme://localhost;{"t":"%s",%s\a' "${GHOSTTY_EXTREME_EVENT_TOKEN:-}" "${1#\{}" > "$tty" 2>/dev/null
}

# True for commands that start a long-running local web server.
is_dev_server() {
  local c="$1"
  # Leading VAR=value assignments (PORT=3000 npm run dev).
  while [[ "$c" =~ ^[A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*[[:space:]]+(.*)$ ]]; do c="${BASH_REMATCH[1]}"; done
  local script='(dev|start|serve|preview|develop|storybook)([:_-][A-Za-z0-9:_-]*)?'
  [[ "$c" =~ ^(npm|pnpm|yarn|bun)[[:space:]]+(run[[:space:]]+)?$script([[:space:]]|$) ]] && return 0
  [[ "$c" =~ ^deno[[:space:]]+task[[:space:]]+$script([[:space:]]|$) ]] && return 0

  # Package runners in front of a tool.
  [[ "$c" =~ ^(npx|bunx|pnpx)[[:space:]]+(.*)$ ]] && c="${BASH_REMATCH[2]}"
  [[ "$c" =~ ^(pnpm[[:space:]]+(exec|dlx)|yarn[[:space:]]+dlx|yarn|bun[[:space:]]+x)[[:space:]]+(.*)$ ]] && c="${BASH_REMATCH[3]}"
  [[ "$c" =~ ^(uv|poetry|pipenv)[[:space:]]+run[[:space:]]+(.*)$ ]] && c="${BASH_REMATCH[2]}"
  [[ "$c" =~ ^bundle[[:space:]]+exec[[:space:]]+(.*)$ ]] && c="${BASH_REMATCH[1]}"

  local patterns=(
    '^vite([[:space:]]+(dev|serve|preview))?([[:space:]]+-.*)?$'
    '^(next|nuxt|nuxi|astro|remix|wrangler|vercel|netlify|svelte-kit|solid-start)[[:space:]]+(dev|start)([[:space:]]|$)'
    '^(react-scripts|expo|docusaurus|electron-forge)[[:space:]]+start([[:space:]]|$)'
    '^ng[[:space:]]+serve([[:space:]]|$)'
    '^(webpack[[:space:]]+serve|webpack-dev-server)([[:space:]]|$)'
    '^gatsby[[:space:]]+develop([[:space:]]|$)'
    '^storybook[[:space:]]+dev([[:space:]]|$)'
    '^(http-server|live-server|serve|json-server)([[:space:]]|$)'
    '^parcel[[:space:]]+(serve[[:space:]]|[^[:space:]]+\.html)'
    '^eleventy[[:space:]].*--serve'
    '^python[0-9.]*[[:space:]]+-m[[:space:]]+(http\.server|uvicorn|streamlit[[:space:]]+run|flask[[:space:]]+run)([[:space:]]|$)'
    '^(python[0-9.]*[[:space:]]+)?(\./)?([^[:space:]]*/)?manage\.py[[:space:]]+runserver([[:space:]]|$)'
    '^flask[[:space:]]+run([[:space:]]|$)'
    '^(uvicorn|gunicorn|hypercorn|daphne)[[:space:]]'
    '^fastapi[[:space:]]+(dev|run)([[:space:]]|$)'
    '^streamlit[[:space:]]+run[[:space:]]'
    '^mkdocs[[:space:]]+serve([[:space:]]|$)'
    '^jupyter[[:space:]]+(lab|notebook)([[:space:]]|$)'
    '^(bin/)?rails[[:space:]]+(s|server)([[:space:]]|$)'
    '^bin/dev$'
    '^rackup([[:space:]]|$)'
    '^jekyll[[:space:]]+serve([[:space:]]|$)'
    '^php[[:space:]]+(-S[[:space:]]|artisan[[:space:]]+serve)'
    '^hugo[[:space:]]+(server|serve)([[:space:]]|$)'
    '^zola[[:space:]]+serve([[:space:]]|$)'
    '^(iex[[:space:]]+-S[[:space:]]+)?mix[[:space:]]+phx\.server([[:space:]]|$)'
  )
  local p
  for p in "${patterns[@]}"; do
    [[ "$c" =~ $p ]] && return 0
  done
  return 1
}

# True for commands that forward a port to this Mac and stay open.
# A session runs in a normal tab, outside the sandbox the agent's own commands get, so a
# tunnel only counts when all it can do is forward a port. ssh runs a program of the
# caller's choice through ProxyCommand and the like, set with -o, -J or a config file (-F),
# and kubectl through a kubeconfig's login command: with any of those it's left to the agent.
is_tunnel() {
  local c="$1" lower
  lower=$(printf '%s' "$c" | tr '[:upper:]' '[:lower:]')
  if [[ "$c" =~ ^(ssh|autossh|gcloud)[[:space:]] ]]; then
    [[ "$lower" == *proxycommand* || "$lower" == *proxyjump* || "$lower" == *--ssh-flag* ]] && return 1
    [[ "$c" =~ [[:space:]]-[A-Za-z0-9]*[oJF] ]] && return 1
  fi
  [[ "$c" =~ ^(ssh|autossh)[[:space:]].*-[A-Za-z]*L[[:space:]]*[0-9] ]] && return 0
  [[ "$c" =~ ^gcloud[[:space:]].*compute[[:space:]]+ssh[[:space:]].*-L[[:space:]]*[0-9] ]] && return 0
  [[ "$c" =~ ^(kubectl|oc)[[:space:]].*port-forward([[:space:]]|$) && "$lower" != *kubeconfig* ]] && return 0
  [[ "$c" =~ ^ngrok[[:space:]]+(http|tcp|tls)([[:space:]]|$) ]] && return 0
  [[ "$c" =~ ^cloudflared[[:space:]].*tunnel([[:space:]]|$) ]] && return 0
  return 1
}

# True when `command` has run in a localhost session in folder `cwd` before.
was_session() {
  local c="$1" cwd f
  cwd=$(printf '%s' "${2%/}" | tr '[:upper:]' '[:lower:]')
  [ -n "$cwd" ] && command -v jq >/dev/null || return 1
  for f in "$dir"/lh-*.json; do
    [ -f "$f" ] || continue
    [[ "$f" == *.status.json ]] && continue
    jq -e --arg c "$c" --arg cwd "$cwd" \
      '.command == $c and ((.cwd // "") | rtrimstr("/") | ascii_downcase) == $cwd' "$f" >/dev/null 2>&1 && return 0
  done
  return 1
}

# For commands an agent runs in the background: a task-runner target whose name says it
# serves something (`make dev`, `just serve`), the same kind of thing as `npm run dev`.
# Only the runner and one target: no options that point it at another file or folder.
# A script of any name (`./x.sh web &`) doesn't count: its name says nothing about what it
# does, and a session runs outside the agent's sandbox. Once someone has started it in a
# session themselves (`localhost start -- './x.sh web'`), `was_session` knows it.
sounds_like_server() {
  local c="$1"
  [[ "$c" =~ ^(make|just|task|mise[[:space:]]+run)[[:space:]]+[A-Za-z0-9_][A-Za-z0-9_:.-]*$ ]] || return 1
  local words
  words=" $(printf '%s' "${c##* }" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' ' ') "
  [[ "$words" =~ [[:space:]](dev|serve|server|devserver|dashboard|tunnel|preview|watch|proxy|web|frontend)[[:space:]] ]]
}

# The folder itself, with symlinks followed, or nothing.
real_folder() { (cd "$1" 2>/dev/null && pwd -P); }

# `cd dir && npm run dev > dev.log 2>&1 &` -> `cd dir && localhost start --log dev.log -- 'npm run dev'`.
# Anything more involved than one server command is left alone. `--cwd` is the folder the
# command runs in; `--background` says the agent was going to run it as a background job.
# A `cd` in front only counts into the project itself: with `cd /tmp && uvicorn app:app` the
# "dev server" is whatever sits in that other folder.
rewrite() {
  local c prefix="" log="" errors="" cwd="" background=0 raw
  raw=$(trim "$1")
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --cwd) cwd="$2"; shift 2 ;;
      --background) background=1; shift ;;
      *) shift ;;
    esac
  done
  c="$raw"
  [[ "$c" == *$'\n'* ]] && return 1
  if [[ "$c" =~ ^(cd[[:space:]]+[^\;\&\|\`\$\<\>]+)\&\&[[:space:]]*(.*)$ ]]; then
    prefix="$(trim "${BASH_REMATCH[1]}") && "
    c="${BASH_REMATCH[2]}"
    # The folder it runs in, for `was_session`.
    local target
    target=$(trim "${BASH_REMATCH[1]#cd}")
    target="${target#[\'\"]}"; target="${target%[\'\"]}"
    case "$target" in "~"*) target="$HOME${target#\~}" ;; /*) ;; *) target="${cwd:-.}/$target" ;; esac
    local project
    project=$(real_folder "${cwd:-.}") || return 1
    cwd=$(real_folder "$target") || return 1
    [[ "$cwd" == "$project" || "$cwd" == "${project%/}"/* ]] || return 1
  fi
  # A trailing `&` means the agent meant it to keep running.
  [[ "$raw" == *"&" && "$raw" != *"&&" ]] && background=1
  [[ "$c" =~ ^nohup[[:space:]]+(.*)$ ]] && c="${BASH_REMATCH[1]}"
  c=$(trim "$c")
  [[ "$c" == *"&" && "$c" != *"&&" ]] && c=$(trim "${c%&}")
  # Redirections at the end, last first: where its output went becomes the session's log.
  # `2>err.log` is a redirection of stream 2, not an argument "2"; /dev/null is no log at
  # all; `2>&1` only joins the two streams, which a session's log does anyway.
  local joined='^(.*[^[:space:]])[[:space:]]+[0-9]?>&[0-9]$'
  local spaced='^(.*[^[:space:]])[[:space:]]+([0-9&]?)>>?[[:space:]]*([^[:space:]<>&;|]+)$'
  local attached='^(.*[^[:space:]<>&])>>?[[:space:]]*([^[:space:]<>&;|]+)$'
  local stream target
  while :; do
    c=$(trim "$c")
    if [[ "$c" =~ $joined ]]; then
      c="${BASH_REMATCH[1]}"
      continue
    fi
    if [[ "$c" =~ $spaced ]]; then
      stream="${BASH_REMATCH[2]}"
      target="${BASH_REMATCH[3]}"
    elif [[ "$c" =~ $attached ]]; then
      stream=""
      target="${BASH_REMATCH[2]}"
    else
      break
    fi
    c="${BASH_REMATCH[1]}"
    case "$target" in
      /dev/null) continue ;;
      "~/"*) target="$HOME/${target#\~/}" ;;
    esac
    # A name the shell would still have to work out (a variable, quotes, a pattern) isn't
    # one to guess at.
    case "$target" in *[\$\'\"\`\*\?\~\(\)\{\}\[\]\\]*) return 1 ;; esac
    case "$stream" in
      ""|1|"&") log="$target" ;;
      2) errors="$target" ;;
      *) return 1 ;;
    esac
  done
  # Only its errors went to a file: that file is the nearest thing to a log it had.
  log="${log:-$errors}"
  [[ "$c" =~ [\;\|\&\`\<\>] || "$c" == *'$('* ]] && return 1
  is_dev_server "$c" || is_tunnel "$c" || was_session "$c" "$cwd" \
    || { [ $background = 1 ] && sounds_like_server "$c"; } || return 1
  printf '%s%s start %s-- %s\n' "$prefix" "$self" "${log:+--log $(quote "$log") }" "$(quote "$c")"
}

status_field() { jq -r "$2 // empty" "$dir/$1.status.json" 2>/dev/null; }

# The port a session serves on: the status file's own "port", or for one written by an older
# version of the app, the one in its URL, which may go on with a path (http://localhost:5173/app/).
session_port() {
  local port url
  port=$(status_field "$1" '(.port | numbers)')
  if [ -z "$port" ]; then
    url=$(status_field "$1" '(.url | strings)')
    url="${url#*://}"
    url="${url%%[/?#]*}"
    case "$url" in *:*) port="${url##*:}" ;; esac
  fi
  case "$port" in ""|*[!0-9]*) return 1 ;; esac
  printf '%s' "$port"
}

# True if something is listening on the session's address.
listening() {
  local port
  port=$(session_port "$1") || return 1
  lsof -nP -iTCP:"$port" -sTCP:LISTEN -t >/dev/null 2>&1
}

print_session() {
  local id="$1" url
  url=$(status_field "$id" .url)
  echo "  URL:     ${url:-(not listening yet)}"
  echo "  Logs:    $self logs $id"
  echo "  Restart: $self restart $id    Stop: $self stop $id"
}

start() {
  local log="" agent=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --log) log="$2"; shift 2 ;;
      --agent) agent="$2"; shift 2 ;;
      --) shift; break ;;
      *) break ;;
    esac
  done
  local cmd="$*"
  [ -n "$cmd" ] || { echo "usage: localhost start [--log FILE] -- '<command>'" >&2; return 2; }
  command -v jq >/dev/null || { echo "localhost: jq is required" >&2; return 1; }
  mkdir -p "$dir"
  [ -n "$log" ] && case "$log" in /*) ;; *) log="$PWD/$log" ;; esac

  # Already a session for this here? Point at it if it's serving; restart it in its tab if
  # it stopped, or stopped listening, instead of opening a second copy.
  local f id state reuse="" join=""
  for f in "$dir"/*.status.json; do
    [ -f "$f" ] || continue
    id=$(basename "$f" .status.json)
    [ "$(jq -r .cwd "$dir/$id.json" 2>/dev/null)" = "$PWD" ] || continue
    [ "$(jq -r .command "$dir/$id.json" 2>/dev/null)" = "$cmd" ] || continue
    state=$(jq -r .state "$f")
    if [ "$state" = "live" ] && listening "$id"; then
      echo "✓ Already running in Tellurion localhost session $id (a separate tab that keeps running)."
      print_session "$id"
      return 0
    fi
    case "$state" in
      live|quiet|exited) reuse="$id"; break ;;
      # Already on its way up (another start got there first): wait for it.
      starting|restarting) join="$id"; break ;;
    esac
  done

  if [ -n "$join" ]; then
    id="$join"
    echo "Waiting for localhost session $id, which is already starting."
  elif [ -n "$reuse" ]; then
    id="$reuse"
    # The app rewrites this as soon as the session runs again.
    printf '{"id":"%s","state":"restarting"}\n' "$id" > "$dir/$id.status.json"
    send "{\"event\":\"restart\",\"id\":\"$id\"}" || { echo "localhost: not running inside Tellurion" >&2; return 1; }
    echo "Restarting localhost session $id in its tab."
  else
    id="lh-$(date +%s)-$RANDOM"
    jq -n --arg id "$id" --arg cwd "$PWD" --arg command "$cmd" --arg log "${log:-$dir/$id.log}" --arg agent "$agent" \
      '{id: $id, cwd: $cwd, command: $command, log: $log, agent: $agent, requested: (now | todate)}' > "$dir/$id.json"
    if ! send "{\"event\":\"open\",\"id\":\"$id\"}"; then
      rm -f "$dir/$id.json"
      echo "localhost: not running inside Tellurion, so no session could be opened." >&2
      return 1
    fi
  fi

  # Wait for the app to open the tab and the server to start listening.
  local waited=0 state
  while [ $waited -lt 100 ]; do
    state=$(status_field "$id" .state)
    case "$state" in
      live)
        echo "✓ Started \`$cmd\` in a Tellurion localhost session: a separate terminal tab that keeps running after you're done."
        print_session "$id"
        return 0 ;;
      exited)
        echo "✗ \`$cmd\` exited (code $(status_field "$id" .code)) before it started listening. Last output:"
        logs "$id" 40
        return 1 ;;
    esac
    if [ -z "$state" ] && [ $waited -ge 20 ]; then
      rm -f "$dir/$id.json"
      echo "localhost: Tellurion didn't open a session (is this terminal in Tellurion?)." >&2
      return 1
    fi
    if [ "$state" = "restarting" ] && [ $waited -ge 20 ]; then
      # The app no longer has that session (its tab is gone): open a new one.
      rm -f "$dir/$id.status.json"
      start ${log:+--log "$log"} ${agent:+--agent "$agent"} -- "$cmd"
      return
    fi
    sleep 0.25
    waited=$((waited + 1))
  done
  echo "✓ Started \`$cmd\` in a Tellurion localhost session (not listening on a port yet)."
  print_session "$id"
}

logs() {
  local id="$1" lines="${2:-80}" log
  log=$(jq -r .log "$dir/$id.json" 2>/dev/null)
  [ -f "$log" ] || { echo "No output yet."; return 0; }
  tail -n "$lines" "$log" | perl -pe 's/\e\[[0-9;?]*[ -\/]*[@-~]//g; s/\e\][^\a\e]*(\a|\e\\)//g; s/\e[()][A-Z0-9]//g; s/\r//g'
}

control() {
  local event="$1" id="$2"
  [ -f "$dir/$id.json" ] || { echo "No localhost session $id" >&2; return 1; }
  send "{\"event\":\"$event\",\"id\":\"$id\"}" || { echo "localhost: not inside Tellurion" >&2; return 1; }
  echo "Asked Tellurion to $event $id."
}

list() {
  local f id any=0
  for f in "$dir"/*.status.json; do
    [ -f "$f" ] || continue
    any=1
    id=$(basename "$f" .status.json)
    printf '%-24s %-8s %-28s %s\n' "$id" "$(jq -r .state "$f")" "$(jq -r '.url // "-"' "$f")" \
      "$(jq -r '.command' "$dir/$id.json" 2>/dev/null)"
  done
  [ $any = 1 ] || echo "No localhost sessions."
}

case "${1:-}" in
  start) shift; start "$@" ;;
  logs) logs "$2" "${3:-80}" ;;
  stop|restart) control "$1" "$2" ;;
  list) list ;;
  rewrite) shift; rewrite "$@" ;;
  *) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
