#!/bin/bash
# Tellurion from the command line.
#
#   tellurion doctor          check the agent status setup and send a live test event
#   tellurion phone [status]  can your phone reach this Mac? (Tailscale), in one line
#   tellurion phone setup     walk through the Tailscale steps, asking before each one
#   tellurion local <model>   chat with a model on this Mac (Ollama, LM Studio, llama.cpp,
#                             MLX or Apple's own); nothing leaves it
#
# Installed to ~/.ghostty-extreme/bin/ by the app (Setup Check, or the welcome window).
# Paste `tellurion doctor` output into GitHub issues: it contains no personal data
# beyond your home folder's name, which it replaces with ~.


hooks="$HOME/.ghostty-extreme/agent-hooks"
legacy="$HOME/.ghostty-custom/agent-hooks"
problems=0
warnings=0

if [ -t 1 ]; then
  green=$'\e[32m'; red=$'\e[31m'; yellow=$'\e[33m'; dim=$'\e[2m'; bold=$'\e[1m'; reset=$'\e[0m'
else
  green=""; red=""; yellow=""; dim=""; bold=""; reset=""
fi

ok() { printf '  %s✓%s %s\n' "$green" "$reset" "$1"; }
bad() { printf '  %s✗%s %s\n' "$red" "$reset" "$1"; problems=$((problems + 1)); }
warn() { printf '  %s!%s %s\n' "$yellow" "$reset" "$1"; warnings=$((warnings + 1)); }
note() { printf '    %s%s%s\n' "$dim" "$1" "$reset"; }
section() { printf '\n%s%s%s\n' "$bold" "$1" "$reset"; }
tidy() { sed "s|$HOME|~|g"; }

# Which of our hook entries an agent's config is missing or runs from elsewhere.
# Usage: check_agent <name> <config file> <agent> <event>...
check_agent() {
  local name=$1 file=$2 agent=$3; shift 3
  local display; display=$(tidy <<<"$file")
  if [ ! -f "$file" ]; then
    bad "$name: $display doesn't exist, so it has no Tellurion hooks"
    note "Fix: Tellurion > Check Setup… > Connect $name"
    return
  fi
  if ! jq empty "$file" 2>/dev/null; then
    bad "$name: $display isn't valid JSON"
    return
  fi
  local missing=() elsewhere=() event command
  for event in "$@"; do
    command=$(jq -r --arg suffix "agent-hook.sh $agent $event" \
      '[.hooks // {} | .[] | .[]? | .hooks[]? | .command? // empty | select(endswith($suffix))] | first // empty' "$file")
    if [ -z "$command" ]; then
      missing+=("$event")
    else
      command=${command/#\~/$HOME}
      case "$command" in
        "$hooks/agent-hook.sh "*|"$legacy/agent-hook.sh "*) ;;
        *) elsewhere+=("$event") ;;
      esac
    fi
  done
  if [ ${#missing[@]} -eq 0 ] && [ ${#elsewhere[@]} -eq 0 ]; then
    ok "$name: all $# hooks connected"
  else
    [ ${#missing[@]} -gt 0 ] && bad "$name: missing hooks for ${missing[*]}"
    [ ${#elsewhere[@]} -gt 0 ] && bad "$name: hooks for ${elsewhere[*]} run from outside ~/.ghostty-extreme (macOS can block those)"
    note "Fix: Tellurion > Check Setup… > Connect $name"
    [ "$agent" = codex ] && note "Codex asks you to approve new hooks once, the next time it starts"
  fi
}

doctor() {
  printf '%sTellurion doctor%s\n' "$bold" "$reset"

  section "Terminal"
  inside=0
  if [ "${GHOSTTY_EXTREME_AGENT_EVENTS:-}" = "1" ] && [ -n "${GHOSTTY_EXTREME_EVENT_TOKEN:-}" ]; then
    ok "Running inside Tellurion"
    inside=1
  else
    warn "Not running inside Tellurion: agent status only works in its own terminals"
  fi
  case "${SHELL:-}" in
    */zsh) ok "Shell: zsh" ;;
    *) warn "Shell: ${SHELL:-unknown}. Agent logos appear when an agent starts only with zsh; status still works" ;;
  esac
  if [ -f "$HOME/.zshrc" ] && grep -qE 'ghostty-(extreme|custom)\.zsh' "$HOME/.zshrc"; then
    ok "~/.zshrc loads the agent detection"
  else
    warn "~/.zshrc doesn't load the agent detection"
    note "Fix: Tellurion > Check Setup… > Add to ~/.zshrc"
  fi

  section "Tools"
  if command -v jq >/dev/null 2>&1; then
    ok "jq $(jq --version 2>/dev/null | sed 's/^jq-//')"
  else
    bad "jq isn't installed; the hooks need it to report anything"
    note "Fix: brew install jq"
  fi
  local tool
  for tool in claude codex git python3 gh docker; do
    if command -v "$tool" >/dev/null 2>&1; then
      ok "$tool: $(command -v "$tool" | tidy)"
    else
      printf '  %s-%s %s isn'"'"'t installed\n' "$dim" "$reset" "$tool"
    fi
  done

  section "Hooks"
  if [ -x "$hooks/agent-hook.sh" ]; then
    ok "Installed in ~/.ghostty-extreme/agent-hooks"
  else
    bad "Not installed in ~/.ghostty-extreme/agent-hooks"
    note "Fix: Tellurion > Check Setup… > Install hooks"
  fi
  if [ -x "$HOME/.ghostty-extreme/bin/localhost" ]; then
    ok "localhost command installed"
  else
    warn "localhost command isn't installed: dev servers agents start won't get their own tab"
  fi
  if [ -e "$HOME/.ghostty-extreme/features/localhost-off" ]; then
    note "Localhost sessions are turned off in Settings"
  fi
  if command -v jq >/dev/null 2>&1; then
    # An agent marked "I don't use it" in Tellurion's Setup Check is left out.
    if [ -e "$HOME/.ghostty-extreme/features/claude-off" ]; then
      note "Claude Code is skipped: marked as not used in Tellurion > Check Setup…"
    elif command -v claude >/dev/null 2>&1 || [ -d "$HOME/.claude" ]; then
      check_agent "Claude Code" "$HOME/.claude/settings.json" claude \
        session_start prompt_submit tool_complete permission_request notification stop stop_failure session_end pre_tool_use
    fi
    if [ -e "$HOME/.ghostty-extreme/features/codex-off" ]; then
      note "Codex is skipped: marked as not used in Tellurion > Check Setup…"
    elif command -v codex >/dev/null 2>&1 || [ -d "$HOME/.codex" ]; then
      check_agent "Codex" "$HOME/.codex/hooks.json" codex \
        session_start prompt_submit pre_tool_use permission_request tool_complete stop session_end subagent_start subagent_stop interrupt
    fi
  fi

  # Claude Code records failed hooks in its transcripts.
  if [ -d "$HOME/.claude/projects" ]; then
    local errors latest
    # The records themselves, not messages that mention them.
    errors=$(find "$HOME/.claude/projects" -name '*.jsonl' -mtime -1 -print0 2>/dev/null \
      | xargs -0 grep -h 'hook_non_blocking_error' 2>/dev/null \
      | jq -c 'select(.attachment.type? == "hook_non_blocking_error"
                      and ((.attachment.command // "") | contains("agent-hook.sh")))' 2>/dev/null || true)
    if [ -n "$errors" ]; then
      latest=$(tail -n 1 <<<"$errors" | jq -r '.attachment.stderr // empty' 2>/dev/null | head -c 200 | tidy)
      warn "Claude Code reported $(wc -l <<<"$errors" | tr -d ' ') hook error(s) in the last day"
      [ -n "$latest" ] && note "Latest: $latest"
    else
      ok "No hook errors from Claude Code in the last day"
    fi
  fi

  section "Live test"
  if [ "$inside" = 1 ] && [ -x "$hooks/agent-hook.sh" ] && command -v jq >/dev/null 2>&1; then
    # The same path a real Claude Code event takes: run the hook, then write what it
    # returns to this terminal, the way Claude Code does.
    local sequence
    sequence=$(printf '{}' | "$hooks/agent-hook.sh" claude check 2>/dev/null | jq -r '.terminalSequence // empty' 2>/dev/null)
    if [ -z "$sequence" ]; then
      bad "The hook ran but produced no event"
    elif { printf '%s' "$sequence" > /dev/tty; } 2>/dev/null; then
      ok "Sent a test event. Tellurion confirms it in the sidebar when it arrives"
    else
      bad "Couldn't write to this terminal (no /dev/tty)"
    fi
  else
    note "Skipped (needs Tellurion, jq and the installed hooks)"
  fi

  printf '\n'
  if [ "$problems" -eq 0 ] && [ "$warnings" -eq 0 ]; then
    printf '%sEverything looks right.%s\n' "$green" "$reset"
  else
    printf '%d problem(s), %d warning(s).\n' "$problems" "$warnings"
  fi
  [ "$problems" -eq 0 ]
}

# --- Phone (Tailscale) -------------------------------------------------------------
# Never turns on `tailscale funnel`: the phone reaches this Mac only inside your tailnet.

# Tailscale.app's own binary acts as the CLI only with this set (as its `tailscale` link does).
export TAILSCALE_BE_CLI=1

ts_bin() {
  command -v tailscale 2>/dev/null && return
  local app=/Applications/Tailscale.app/Contents/MacOS/Tailscale
  [ -x "$app" ] && echo "$app"
}

# Prints one of: not-installed app-off stopped needs-login starting https-off no-phone ready,
# then (for ready/no-phone) this Mac's name and the online phone's name.
phone_state() {
  local ts json state
  command -v jq >/dev/null || { echo "no-jq"; return; }
  ts=$(ts_bin) || { echo "not-installed"; return; }
  [ -n "$ts" ] || { echo "not-installed"; return; }
  json=$("$ts" status --json 2>/dev/null) && [ -n "$json" ] && jq empty <<<"$json" 2>/dev/null \
    || { echo "app-off"; return; }
  state=$(jq -r .BackendState <<<"$json")
  case "$state" in
    Running) ;;
    Stopped) echo "stopped"; return ;;
    NeedsLogin|NeedsMachineAuth) echo "needs-login"; return ;;
    *) echo "starting"; return ;;
  esac
  local mac https magic phones online
  mac=$(jq -r '.Self.DNSName // "" | rtrimstr(".")' <<<"$json")
  magic=$(jq -r '.CurrentTailnet.MagicDNSEnabled // false' <<<"$json")
  https=$(jq -r '(.CertDomains // []) | length' <<<"$json")
  phones=$(jq -r '[.Peer // {} | .[] | select(.OS == "iOS" or .OS == "android")] | length' <<<"$json")
  online=$(jq -r '[.Peer // {} | .[] | select((.OS == "iOS" or .OS == "android") and .Online)
    | (if (.HostName // "") == "" or .HostName == "localhost" then (.DNSName | split(".")[0]) else .HostName end)] | first // ""' <<<"$json")
  if [ "$magic" != true ] || [ "$https" = 0 ]; then echo "https-off $mac"; return; fi
  [ "$phones" = 0 ] && { echo "no-phone $mac"; return; }
  echo "ready $mac $online"
}

phone_status() {
  local state mac online
  read -r state mac online <<<"$(phone_state)"
  case "$state" in
    no-jq) printf '%s!%s Phone · needs jq to read Tailscale'"'"'s status   %sbrew install jq%s\n' "$yellow" "$reset" "$dim" "$reset" ;;
    not-installed) printf '%s○%s Phone · Tailscale not installed   %stellurion phone setup%s\n' "$dim" "$reset" "$dim" "$reset" ;;
    app-off|stopped) printf '%s○%s Phone · Tailscale off   %stellurion phone setup%s\n' "$dim" "$reset" "$dim" "$reset" ;;
    needs-login) printf '%s●%s Phone · sign in to Tailscale   %stellurion phone setup%s\n' "$yellow" "$reset" "$dim" "$reset" ;;
    starting) printf '%s●%s Phone · Tailscale connecting…\n' "$yellow" "$reset" ;;
    https-off) printf '%s●%s Phone · turn on HTTPS for your tailnet   %stellurion phone setup%s\n' "$yellow" "$reset" "$dim" "$reset" ;;
    no-phone) printf '%s●%s Phone · add your phone to your tailnet (%s)\n' "$yellow" "$reset" "$mac" ;;
    ready)
      if [ -n "$online" ]; then
        printf '%s●%s Phone · ready · %s online · %s\n' "$green" "$reset" "$online" "$mac"
      else
        printf '%s●%s Phone · ready · phone offline · %s\n' "$green" "$reset" "$mac"
      fi ;;
  esac
}

# Enter means yes; no terminal or end of input means no.
ask() {
  local reply
  printf '%s [Y/n] ' "$1"
  { read -r reply </dev/tty; } 2>/dev/null || { echo; return 1; }
  [[ -z "$reply" || "$reply" =~ ^[Yy] ]]
}

phone_setup() {
  command -v jq >/dev/null || { echo "tellurion: jq is required (brew install jq)" >&2; return 1; }
  local state mac online ts
  local steps=0
  while [ $steps -lt 8 ]; do
    steps=$((steps + 1))
    read -r state mac online <<<"$(phone_state)"
    ts=$(ts_bin)
    case "$state" in
      not-installed)
        if command -v brew >/dev/null && ask "Tailscale isn't installed. Install it with Homebrew (brew install --cask tailscale)?"; then
          brew install --cask tailscale && open -a Tailscale && sleep 4 || return 1
        else
          echo "Get it from https://tailscale.com/download, then run this again."; return 1
        fi ;;
      app-off)
        ask "Tailscale isn't running. Open it?" || return 1
        open -a Tailscale; sleep 4 ;;
      stopped|needs-login)
        ask "Turn Tailscale on (tailscale up)? Signing in opens in your browser." || return 1
        "$ts" up || return 1 ;;
      starting) sleep 2 ;;
      https-off)
        echo "Turn on MagicDNS and HTTPS Certificates on Tailscale's DNS page:"
        echo "  https://login.tailscale.com/admin/dns"
        ask "Open it now?" && open "https://login.tailscale.com/admin/dns"
        printf 'Waiting for HTTPS to be on (Ctrl-C to stop)'
        while [ "$(phone_state | cut -d' ' -f1)" = https-off ]; do printf '.'; sleep 3; done
        echo ;;
      no-phone)
        echo "Install Tailscale on your phone and sign in with the same account: https://tailscale.com/download"
        printf 'Waiting for your phone to join (Ctrl-C to stop)'
        while [ "$(phone_state | cut -d' ' -f1)" = no-phone ]; do printf '.'; sleep 3; done
        echo ;;
      ready) phone_status; return 0 ;;
    esac
  done
  phone_status
}

# A chat with a model on this Mac, through Ollama (nothing leaves the Mac).
local_model() {
  if [ -z "${1:-}" ]; then
    printf 'Usage: tellurion local [--provider ollama|lmstudio|openai|apple] [--base URL] <model>\n' >&2
    return 2
  fi
  exec python3 "$hooks/local-chat.py" "$@"
}

case "${1:-doctor}" in
  doctor) doctor ;;
  local) shift; local_model "$@" ;;
  phone)
    case "${2:-status}" in
      status) phone_status ;;
      setup) phone_setup ;;
      *) printf 'Usage: tellurion phone [status|setup]\n' >&2; exit 2 ;;
    esac ;;
  -h|--help|help)
    sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *)
    printf 'Unknown command: %s\n' "$1" >&2
    sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//' >&2
    exit 2
    ;;
esac
